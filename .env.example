MIKROTIK_HOST=192.168.0.1
MIKROTIK_PORT=8728
MIKROTIK_USER=identitysync
MIKROTIK_PASSWORD=

ADGUARD_URL=http://192.168.0.103
ADGUARD_USER=admin
ADGUARD_PASSWORD=
ADGUARD_VERIFY_TLS=yes
ADGUARD_TIMEOUT=30
ADGUARD_RETRY_INTERVAL=30
ADGUARD_SYNC_DEBOUNCE=2
SYSLOG_LISTEN_ADDRESS=0.0.0.0
SYSLOG_LISTEN_PORT=1514
# Comma-separated IPs/CIDRs. Defaults to MIKROTIK_HOST. Source filtering is defense-in-depth;
# syslog contents are never trusted and only trigger RouterOS API reconciliation.
SYSLOG_ALLOWED_SOURCES=192.168.0.1
HTTP_LISTEN_ADDRESS=0.0.0.0:8080

# Logging. info hides high-frequency refresh/no-op messages; debug shows them.
LOG_LEVEL=info
RECONCILE_INTERVAL=1800
# 0 disables the periodic identity table. Set >0 and LOG_LEVEL=debug to print it.
PRINT_TABLE_INTERVAL=0
INCOMPLETE_RADIUS_PACKET_TIMEOUT=30
# Optional. When set, enables authenticated GET /api/kid-control.
KID_CONTROL_API_TOKEN=

# Optional nxFilter 4.7.5.4 RADIUS Accounting backend.
NXFILTER_ENABLED=false
NXFILTER_HOST=
NXFILTER_ACCOUNTING_PORT=1813
NXFILTER_SHARED_SECRET=
NXFILTER_NAS_IDENTIFIER=mikrotik-adguard-identity
NXFILTER_TIMEOUT=5
NXFILTER_REFRESH_INTERVAL=300
